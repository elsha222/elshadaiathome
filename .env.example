# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Brevo transactional email API key
# Get from: https://app.brevo.com → Settings → SMTP & API → API Keys
VITE_BREVO_API_KEY=

# Google Apps Script Web App URL (for CRM / Google Sheets)
# Get from: Google Sheet → Extensions → Apps Script → Deploy → Web App URL
VITE_SHEETS_WEBHOOK_URL=
